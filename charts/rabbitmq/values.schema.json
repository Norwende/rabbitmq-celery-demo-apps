{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "rabbitmq values",
  "type": "object",
  "required": ["image", "replicas", "persistence"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "replicas": { "type": "integer", "minimum": 1 },
    "resources": { "type": "object" },
    "persistence": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "storageClassName": { "type": "string" },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)?$" }
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "additionalPlugins": { "type": "array", "items": { "type": "string" } },
    "additionalConfig": { "type": "string" }
  },
  "additionalProperties": false
}
