{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "orderflow-infra values",
  "type": "object",
  "required": ["rabbitmq", "redis"],
  "properties": {
    "clusterDomain": { "type": "string", "minLength": 1 },
    "rabbitmq": {
      "type": "object",
      "required": ["image", "replicas", "persistence"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "persistence": {
          "type": "object",
          "required": ["size"],
          "properties": {
            "storageClassName": { "type": "string" },
            "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)?$" }
          },
          "additionalProperties": false
        },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "additionalPlugins": { "type": "array", "items": { "type": "string" } },
        "additionalConfig": { "type": "string" }
      },
      "additionalProperties": false
    },
    "redis": {
      "type": "object",
      "required": ["image", "replicas", "masterName", "persistence", "sentinel", "auth"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "replicas": {
          "type": "integer",
          "minimum": 3,
          "description": "1 master + réplicas, un sentinel par pod : 3 au minimum pour un quorum de 2."
        },
        "masterName": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "maxmemory": { "type": "string", "pattern": "^[0-9]+(kb|mb|gb)$" },
        "resources": { "type": "object" },
        "persistence": {
          "type": "object",
          "required": ["size"],
          "properties": {
            "storageClassName": { "type": "string" },
            "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)?$" }
          },
          "additionalProperties": false
        },
        "sentinel": {
          "type": "object",
          "properties": {
            "quorum": { "type": "integer", "minimum": 1 },
            "resources": { "type": "object" }
          },
          "additionalProperties": false
        },
        "init": {
          "type": "object",
          "properties": { "resources": { "type": "object" } },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": { "existingSecret": { "type": "string" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
